// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  address       String?
  lastIp        String?
  role          String    @default("USER") // USER, STAFF, ADMIN
  points        Int       @default(0)
  pointsUpdatedAt DateTime @default(now())
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  pointTransactions PointTransaction[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  products    Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isActive    Boolean   @default(true)
  imageUrl    String?
  images      String[]  @default([])
  variants    ProductVariant[]
  reviews     Review[]
  favorites   Favorite[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String?
  color          String?

  price          Float
  stockQuantity  Int       @default(0)
  orderItems     OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderCode       String?     @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  totalAmount     Float
  status          String      @default("PENDING") // PENDING, SHIPPING, COMPLETED, CANCELLED
  paymentMethod   String      @default("MANUAL") // MANUAL, VNPAY, MOMO
  shippingAddress String?
  shippingPhone   String?
  shippingName    String?
  couponCode      String?
  discountAmount  Float       @default(0)
  pointsEarned    Int         @default(0)
  pointsUsed      Int         @default(0)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant  @relation(fields: [variantId], references: [id])
  quantity      Int
  priceAtTime   Float
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, productId])
}

model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  discountPercentage Float?   
  discountAmount     Float?   
  minOrderValue      Float?   
  maxUses            Int?     
  currentUses        Int      @default(0)
  isActive           Boolean  @default(true)
}

model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?  // Optional, links to Order if the transaction is related to an order
  amount      Int      // Positive for EARN/REFUND (if admin refunds points?), usually positive for EARN, negative for SPEND/EXPIRE/REFUND
  type        String   // 'EARN', 'SPEND', 'REFUND', 'EXPIRE'
  description String?
  createdAt   DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   
  coverImage  String?
  author      String?  @default("Admin")
  tags        String?  
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateLimit {
  id        String   @id @default(cuid())
  ip        String
  action    String
  createdAt DateTime @default(now())
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  ip        String?
  sessionId String?
  userId    String?
  createdAt DateTime @default(now())
}

model ActionLog {
  id        String   @id @default(cuid())
  action    String
  element   String?
  path      String
  ip        String?
  sessionId String?
  userId    String?
  createdAt DateTime @default(now())
}
